@model StoreMVC.Models.OrderViewModel

@{
    ViewBag.Title = "Checkout";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">

            <nav class="breadcrumb bg-light mb-30">

                <a class="breadcrumb-item text-dark"
                   href="@Url.Action("Index", "Home")">
                    Home
                </a>

                <a class="breadcrumb-item text-dark"
                   href="@Url.Action("Index", "Store")">
                    Shop
                </a>

                <span class="breadcrumb-item active">
                    Checkout
                </span>

            </nav>

        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Checkout Start -->

@using (Html.BeginForm("Order", "Order", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="container-fluid">

        <div class="row px-xl-5">

            <!-- ========================= -->
            <!-- BILLING ADDRESS -->
            <!-- ========================= -->

            <div class="col-lg-8">

                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">
                        Billing Address
                    </span>
                </h5>


                <div class="bg-light p-30 mb-5">

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "text-danger mb-3" }
                    )

                    <div class="row">

                        <!-- Full Name -->
                        <div class="col-md-12 form-group">

                            @Html.LabelFor(m => m.FullName)

                            @Html.TextBoxFor(
                                m => m.FullName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nguyễn Văn A"
                                }
                            )

                            @Html.ValidationMessageFor(
                                m => m.FullName,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>


                        <!-- Email -->
                        <div class="col-md-6 form-group">

                            @Html.LabelFor(m => m.Email)

                            @Html.TextBoxFor(
                                m => m.Email,
                                new
                                {
                                    @class = "form-control",
                                    type = "email",
                                    placeholder = "example@email.com"
                                }
                            )

                            @Html.ValidationMessageFor(
                                m => m.Email,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>


                        <!-- Phone -->
                        <div class="col-md-6 form-group">

                            @Html.LabelFor(m => m.Phone)

                            @Html.TextBoxFor(
                                m => m.Phone,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "0901234567"
                                }
                            )

                            @Html.ValidationMessageFor(
                                m => m.Phone,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>


                        <!-- Address -->
                        <div class="col-md-12 form-group">

                            @Html.LabelFor(m => m.Address)

                            @Html.TextAreaFor(
                                m => m.Address,
                                new
                                {
                                    @class = "form-control",
                                    rows = "4",
                                    placeholder = "Nhập địa chỉ giao hàng"
                                }
                            )

                            @Html.ValidationMessageFor(
                                m => m.Address,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- ORDER TOTAL -->
            <!-- ========================= -->

            <div class="col-lg-4">

                <h5 class="section-title position-relative text-uppercase mb-3">

                    <span class="bg-secondary pr-3">
                        Order Total
                    </span>

                </h5>


                <div class="bg-light p-30 mb-5">

                    <!-- PRODUCTS -->

                    <div class="border-bottom">

                        <h6 class="mb-3">
                            Products
                        </h6>


                        @if (Model.CartItems != null &&
                             Model.CartItems.Any())
                        {
                            foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between">

                                    <p>
                                        @item.ProductName
                                        <small>
                                            x @item.Quantity
                                        </small>
                                    </p>

                                    <p>
                                        @item.Total.ToString("N0") VNĐ
                                    </p>

                                </div>
                            }
                        }

                    </div>


                    <!-- SUBTOTAL / SHIPPING -->

                    <div class="border-bottom pt-3 pb-2">

                        <div class="d-flex justify-content-between mb-3">

                            <h6>
                                Subtotal
                            </h6>

                            <h6>
                                @Model.SubTotal.ToString("N0") VNĐ
                            </h6>

                        </div>


                        <div class="d-flex justify-content-between">

                            <h6 class="font-weight-medium">
                                Shipping
                            </h6>

                            <h6 class="font-weight-medium">
                                @Model.ShippingCost.ToString("N0") VNĐ
                            </h6>

                        </div>

                    </div>


                    <!-- TOTAL -->

                    <div class="pt-2">

                        <div class="d-flex justify-content-between mt-2">

                            <h5>
                                Total
                            </h5>

                            <h5>
                                @(
                                    (Model.SubTotal +
                                     Model.ShippingCost)
                                    .ToString("N0")
                                ) VNĐ
                            </h5>

                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- PAYMENT -->
                <!-- ========================= -->

                <div class="mb-5">

                    <h5 class="section-title position-relative text-uppercase mb-3">

                        <span class="bg-secondary pr-3">
                            Payment
                        </span>

                    </h5>


                    <div class="bg-light p-30">

                        <div class="form-group">

                            <div class="custom-control custom-radio">

                                <input type="radio"
                                       class="custom-control-input"
                                       name="payment"
                                       id="cod"
                                       checked />

                                <label class="custom-control-label"
                                       for="cod">
                                    Cash on Delivery
                                </label>

                            </div>

                        </div>


                        <div class="form-group">

                            <div class="custom-control custom-radio">

                                <input type="radio"
                                       class="custom-control-input"
                                       name="payment"
                                       id="banktransfer" />

                                <label class="custom-control-label"
                                       for="banktransfer">
                                    Bank Transfer
                                </label>

                            </div>

                        </div>


                        <div class="form-group mb-4">

                            <div class="custom-control custom-radio">

                                <input type="radio"
                                       class="custom-control-input"
                                       name="payment"
                                       id="paypal" />

                                <label class="custom-control-label"
                                       for="paypal">
                                    PayPal
                                </label>

                            </div>

                        </div>


                        <!-- PLACE ORDER -->

                        <button type="submit"
                                class="btn btn-block btn-primary font-weight-bold py-3">

                            Place Order

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}

<!-- Checkout End -->