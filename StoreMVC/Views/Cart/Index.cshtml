@model StoreMVC.Models.CartViewModel

@{
    ViewBag.Title = "Giỏ Hàng";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index", "Home")">Home</a>
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index", "Store")">Shop</a>
                <span class="breadcrumb-item active">Shopping Cart</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Cart Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            @if (Model.CartItems != null && Model.CartItems.Any())
            {
                <table class="table table-light table-borderless table-hover text-center mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <!-- 6 Tiêu đề cột -->
                            <th>Products</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Remove</th>
                            <th>Update</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">

                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <!-- CỘT 1: SẢN PHẨM -->
                                <td class="align-middle text-left">
                                    <img src="~/Resources/img/@item.ProductImage" alt="" style="width: 50px;">
                                    @item.ProductName
                                </td>

                                <!-- CỘT 2: GIÁ TIỀN -->
                                <td class="align-middle">@item.Price.ToString("N0") VNĐ</td>

                                <!-- CỘT 3: SỐ LƯỢNG (Bọc Form riêng tại ô này) -->
                                <td class="align-middle">
                                    <form id="form-update-@item.ProductId" action="@Url.Action("UpdateQuantity", "Cart")" method="post" class="m-0">
                                        <input type="hidden" name="productId" value="@item.ProductId" />

                                        <div class="input-group quantity mx-auto" style="width: 100px;">
                                            <div class="input-group-btn">
                                                <button type="button" class="btn btn-sm btn-primary btn-minus">
                                                    <i class="fa fa-minus"></i>
                                                </button>
                                            </div>
                                            <input type="text" name="quantity" class="form-control form-control-sm bg-secondary border-0 text-center" value="@item.Quantity" min="1">
                                            <div class="input-group-btn">
                                                <button type="button" class="btn btn-sm btn-primary btn-plus">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </td>

                                <!-- CỘT 4: TỔNG TIỀN -->
                                <td class="align-middle">@item.Total.ToString("N0") VNĐ</td>

                                <!-- CỘT 5: XÓA -->
                                <td class="align-middle">
                                    <a href="@Url.Action("Remove", "Cart", new { id = item.ProductId })" class="btn btn-sm btn-danger">
                                        <i class="fa fa-times"></i>
                                    </a>
                                </td>

                                <!-- CỘT 6: CẬP NHẬT -->
                                <td class="align-middle">
                                    <!-- Nút submit dùng form="..." để trỏ về đúng ID của form ở cột số lượng -->
                                    <button type="submit" form="form-update-@item.ProductId" class="btn btn-sm btn-success">Cập nhật</button>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

                <!-- NÚT CLEAR CART VÀ TIẾP TỤC MUA SẮM (Đã được chèn vào đây) -->
                <div class="d-flex justify-content-between mt-3">
                    <a href="@Url.Action("Clear", "Cart")" class="btn btn-danger">
                        <i class="fa fa-trash mr-1"></i> Xóa toàn bộ giỏ hàng
                    </a>
                    <a href="@Url.Action("Index", "Store")" class="btn btn-primary">
                        Tiếp tục mua sắm
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <span class="text-danger">Giỏ hàng trống</span>
                    <br />
                    <a href="@Url.Action("Index", "Store")" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <form class="mb-30" action="">
                <div class="input-group">
                    <input type="text" class="form-control border-0 p-4" placeholder="Coupon Code">
                    <div class="input-group-append">
                        <button class="btn btn-primary">Apply Coupon</button>
                    </div>
                </div>
            </form>
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Cart Summary</span></h5>
            <div class="bg-light p-30 mb-5">
                <div class="border-bottom pb-2">
                    <div class="d-flex justify-content-between mb-3">
                        <h6>Subtotal</h6>
                        <h6>@Model.CartTotal.ToString("N0") VNĐ</h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">Shipping</h6>
                        <h6 class="font-weight-medium">@Model.ShippingCost.ToString("N0") VNĐ</h6>
                    </div>
                </div>
                <div class="pt-2">
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Total</h5>
                        <h5>@Model.Total.ToString("N0") VNĐ</h5>
                    </div>
                    <a href="@Url.Action("Index", "Order")"
                       class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                        Proceed To Checkout
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart End -->