@model StoreMVC.Models.Product
@{
    ViewBag.Title = "Detailed Page";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index", "Home")">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="@Url.Action("Index", "Store")">Cửa hàng</a>
                <span class="breadcrumb-item active">@Model.Name</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Shop Detail Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        <div class="col-lg-5 mb-30">
            <div id="product-carousel" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner bg-light">
                    <!-- Hiển thị hình ảnh động từ database -->
                    <div class="carousel-item active">
                        <img class="w-100 h-100" src="~/Resources/img/@Model.ImageUrl" alt="@Model.Name">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7 h-auto mb-30">
            <div class="h-100 bg-light p-30">
                <!-- Hiển thị Tên và Giá động -->
                <h3>@Model.Name</h3>

                <div class="d-flex mb-3">
                    <div class="text-primary mr-2">
                        <small class="fas fa-star"></small>
                        <small class="fas fa-star"></small>
                        <small class="fas fa-star"></small>
                        <small class="fas fa-star-half-alt"></small>
                        <small class="far fa-star"></small>
                    </div>
                    <small class="pt-1">(99 Reviews)</small>
                </div>

                <!-- Định dạng giá tiền -->
                <h3 class="font-weight-semi-bold mb-4 text-danger">@Model.Price.ToString("N0") VNĐ</h3>

                <p class="mb-4">
                    Sản phẩm <strong>@Model.Name</strong> hiện đang được phân phối chính hãng. Chất liệu cao cấp, kiểu dáng hiện đại, mang lại sự thoải mái tối đa cho người sử dụng.
                </p>

                <!-- Các tùy chọn Size/Color (Hiện tại giữ giao diện tĩnh) -->
                <div class="d-flex mb-3">
                    <strong class="text-dark mr-3">Sizes:</strong>
                    <form>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="size-1" name="size" checked>
                            <label class="custom-control-label" for="size-1">XS</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="size-2" name="size">
                            <label class="custom-control-label" for="size-2">S</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="size-3" name="size">
                            <label class="custom-control-label" for="size-3">M</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="size-4" name="size">
                            <label class="custom-control-label" for="size-4">L</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="size-5" name="size">
                            <label class="custom-control-label" for="size-5">XL</label>
                        </div>
                    </form>
                </div>
                <div class="d-flex mb-4">
                    <strong class="text-dark mr-3">Colors:</strong>
                    <form>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="color-1" name="color" checked>
                            <label class="custom-control-label" for="color-1">Black</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="color-2" name="color">
                            <label class="custom-control-label" for="color-2">White</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" class="custom-control-input" id="color-3" name="color">
                            <label class="custom-control-label" for="color-3">Red</label>
                        </div>
                    </form>
                </div>

                <!-- ĐÃ SỬA: BỌC NÚT ADD TO CART TRONG FORM ĐỂ CHUYỂN DỮ LIỆU ĐI -->
                <form action="@Url.Action("Add", "Cart")" method="post">
                    <!--[cite: 25]-->
                    <input type="hidden" name="id" value="@Model.Id" /> <!--[cite: 25]-->
                    <input type="hidden" name="name" value="@Model.Name" /> <!--[cite: 25]-->
                    <input type="hidden" name="image" value="@Model.ImageUrl" /> <!--[cite: 25]-->
                    <input type="hidden" name="price" value="@Model.Price" /> <!--[cite: 25]-->

                    <div class="d-flex align-items-center mb-4 pt-2">
                        <div class="input-group quantity mr-3" style="width: 130px;">
                            <div class="input-group-btn">
                                <button type="button" class="btn btn-primary btn-minus">
                                    <i class="fa fa-minus"></i>
                                </button>
                            </div>
                            <!-- THUỘC TÍNH NAME QUAN TRỌNG ĐỂ GỬI SỐ LƯỢNG -->
                            <input type="text" name="quantity" class="form-control bg-secondary border-0 text-center" value="1"> <!--[cite: 25]-->
                            <div class="input-group-btn">
                                <button type="button" class="btn btn-primary btn-plus">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary px-3">
                            <!--[cite: 25]-->
                            <i class="fa fa-shopping-cart mr-1"></i> Add To Cart
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tab chi tiết sản phẩm -->
    <div class="row px-xl-5">
        <div class="col">
            <div class="bg-light p-30">
                <div class="nav nav-tabs mb-4">
                    <a class="nav-item nav-link text-dark active" data-toggle="tab" href="#tab-pane-1">Description</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-2">Information</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-3">Reviews (0)</a>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-pane-1">
                        <h4 class="mb-3">Product Description</h4>
                        <p>Đây là phần mô tả chi tiết cho sản phẩm <strong>@Model.Name</strong>. Trong các dự án thực tế, bạn sẽ thêm cột Description vào bảng Product trong SQL Server để lưu nội dung này.</p>
                    </div>
                    <div class="tab-pane fade" id="tab-pane-2">
                        <h4 class="mb-3">Additional Information</h4>
                        <p>Chất liệu: Cotton 100%<br />Xuất xứ: Việt Nam<br />Thương hiệu: MultiShop</p>
                    </div>
                    <div class="tab-pane fade" id="tab-pane-3">
                        <div class="row">
                            <div class="col-md-6">
                                <h4 class="mb-4">1 review for "@Model.Name"</h4>
                                <div class="media mb-4">
                                    <div class="media-body">
                                        <h6>Khách hàng ẩn danh<small> - <i>Hôm nay</i></small></h6>
                                        <div class="text-primary mb-2">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                        </div>
                                        <p>Sản phẩm rất tuyệt vời, giao hàng nhanh chóng!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Shop Detail End -->